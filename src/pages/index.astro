---
import Base from '../layouts/Base.astro';
import PlanDrawing from '../components/PlanDrawing.astro';
import { getStudies, studyHeader, inlineMd } from '../lib/study';
import { Content as Apresentacao } from '../../apresentacao.md';

// Os apêndices têm página própria, mas não aparecem na capa.
const studies = (await getStudies()).filter((entry) => !/apendice/i.test((entry.filePath ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, ''))).map((entry, i) => ({
  href: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${entry.id}/`,
  n: String(i + 1).padStart(2, '0'),
  ...studyHeader(entry.body),
}));
---
<Base title="Estudos">
  <header class="topbar">
    <span class="topbar-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32"><rect x="6" y="6" width="9" height="9"/><rect x="17" y="6" width="9" height="20" class="f"/><rect x="6" y="17" width="9" height="9"/></svg>
    </span>
  </header>

  <main class="cover">
    <div class="hero-drawing cover-drawing"><PlanDrawing /></div>
    <div class="cover-content">
    <div class="cover-intro" data-cover-item><Apresentacao /></div>
    <ol class="cover-list">
      {studies.map((s) => (
        <li class="cover-item" data-cover-item>
          <a href={s.href}>
            <span class="cover-n">{s.n}</span>
            <span class="cover-body">
              <span class="cover-byline" set:html={inlineMd(s.byline, { links: false })} />
              <span class="cover-title">
                {s.titleMain}{s.titleSub && <em>{s.titleSub}</em>}
              </span>
              {s.lead && <span class="cover-lead" set:html={inlineMd(s.lead)} />}
            </span>
            <span class="cover-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    </div>
  </main>

  <script>
    import '../scripts/cover.ts';
  </script>
</Base>
